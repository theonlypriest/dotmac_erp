# =============================================================================
# Dotmac ERP Configuration
# =============================================================================
# Copy this file to .env and configure for your environment.
# For production, use OpenBao for secrets management (see below).
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For Docker: Use db:5432 (internal network)
# For local dev: Use localhost:5435 (exposed port from docker-compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5435/dotmac_erp
# Alembic-only credential. Supply this to `scripts/deploy.sh` from the approved
# secret source; leave it blank in the app env file so runtime processes never
# hold migration authority. Must connect as app_admin (BYPASSRLS, NOSUPERUSER).
MIGRATION_DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dotmac_erp
# Optional: DSN used by MCP `erp-db` server (recommended read-only user).
# Example:
# DOTMAC_ERP_DB_DSN=postgresql://claude_readonly:replace_me@localhost:5435/dotmac_erp
DOTMAC_ERP_DB_DSN=

# Connection pool settings (adjust for your workload)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_PASSWORD=redis
REDIS_URL=redis://:redis@localhost:6380/0
CELERY_BROKER_URL=redis://:redis@localhost:6380/0
CELERY_RESULT_BACKEND=redis://:redis@localhost:6380/1
CELERY_TIMEZONE=Africa/Lagos

# -----------------------------------------------------------------------------
# Authentication - REQUIRED SECRETS
# -----------------------------------------------------------------------------
# These are REQUIRED for the application to start.
# Option 1: Direct values (development only!)
# Option 2: OpenBao references (recommended for production)
#
# Generate JWT_SECRET:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Generate TOTP_ENCRYPTION_KEY:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# OpenBao reference format:
#   JWT_SECRET=bao://secret/dotmac#jwt_secret
#   TOTP_ENCRYPTION_KEY=bao://secret/dotmac#totp_key
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
TOTP_ISSUER=dotmac_erp
TOTP_ENCRYPTION_KEY=

# ERP has no external-identity provider integration. Login is local username
# and password only. The OIDC_* variables that used to appear here were deleted
# with the unshipped implementation and are read by nothing — setting them has
# no effect. See docs/oidc_identity_contract.md before reintroducing any.

# -----------------------------------------------------------------------------
# Cookie Security
# -----------------------------------------------------------------------------
# PRODUCTION: Set REFRESH_COOKIE_SECURE=true and SAMESITE=strict
# Development defaults below are for local testing only
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/

# Public application URL used for absolute links in emails
APP_URL=https://erp.example.com
APP_VERSION=1.33.4

# Licensing bypass is development-only and must be explicit. Production sets
# this to false and supplies the signed license artifact before deployment.
DOTMAC_DEV_MODE=true
LICENSE_FILE_PATH=/app/license/dotmac.lic

# Container image for app/worker/beat — an immutable OCI digest reference.
#
# DELIBERATELY UNSET, and deliberately not a tag. This key replaced
# `ERP_IMAGE_TAG=latest`, whose default was the defect: docker-compose.yml read
# `${ERP_IMAGE_TAG:-latest}`, so an absent or stale key floated production onto
# a mutable tag instead of failing. compose now reads `${APP_IMAGE:?...}` — an
# unset value refuses to start rather than resolving to something mutable.
#
# scripts/deploy.sh writes this key on every deploy, resolving it from
# deploy/rendered/docker-compose.yml (rendered from deploy/product.toml, which
# carries the digest protected-main CI resolved for the image it built and
# tested). Set it by hand only to pin an exact earlier release:
#
#   APP_IMAGE=ghcr.io/michaelayoade/dotmac_erp@sha256:<64 hex>
#
# A tag here is refused by scripts/resolve_deploy_image.sh, which is the one
# gate every deploy path funnels through.
# APP_IMAGE=

# Build-only credential pointer for the private Forgejo package index. The
# referenced file contains the read token; never put that value in this file or
# in Compose. It is used only when building the `app-dev` profile locally.
FORGEJO_TOKEN_FILE=/run/secrets/dotmac/forgejo-read-token

# -----------------------------------------------------------------------------
# OpenBao / Vault Configuration (Secrets Management)
# -----------------------------------------------------------------------------
# Enable OpenBao for production secrets management.
# When configured, secrets can reference OpenBao using URI format:
#   bao://mount/path#field
#   openbao://mount/path#field
#   vault://mount/path#field
#
# Example: JWT_SECRET=bao://secret/dotmac#jwt_secret
# -----------------------------------------------------------------------------
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=devtoken
OPENBAO_NAMESPACE=
OPENBAO_KV_VERSION=2
# Allow non-HTTPS connections (dev only, never in production!)
OPENBAO_ALLOW_INSECURE=false

# -----------------------------------------------------------------------------
# S3 / MinIO Object Storage
# -----------------------------------------------------------------------------
# MinIO container credentials (used by docker-compose for the MinIO service)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# S3 client settings (used by the app to connect to MinIO)
# For Docker: Use http://minio:9000 (internal network)
# For local dev: Use http://localhost:9000 (exposed port)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=dotmac-erp
S3_REGION=us-east-1
S3_CONNECT_TIMEOUT_S=3.0
S3_READ_TIMEOUT_S=10.0
IMPORT_MAX_FILE_SIZE_BYTES=536870912
IMPORT_PARTITION_ROWS=200
IMPORT_PARTITION_MAX_BYTES=8388608
IMPORT_VALIDATION_WORKERS=2

# -----------------------------------------------------------------------------
# Branding
# -----------------------------------------------------------------------------
BRAND_NAME=Dotmac ERP
BRAND_TAGLINE=Unified ERP for finance, HR, and operations
BRAND_LOGO_URL=
BRAND_MARK=
DEFAULT_FUNCTIONAL_CURRENCY_CODE=NGN
DEFAULT_PRESENTATION_CURRENCY_CODE=NGN

# -----------------------------------------------------------------------------
# Landing Page Content
# -----------------------------------------------------------------------------
LANDING_HERO_BADGE=Dotmac ERP
LANDING_HERO_TITLE=Run your entire business on one ERP
LANDING_HERO_SUBTITLE=Finance, HR, and operations with real-time reporting.
LANDING_CTA_PRIMARY=Get started
LANDING_CTA_SECONDARY=Explore modules
LANDING_CONTENT_JSON=

# -----------------------------------------------------------------------------
# Celery Scheduler
# -----------------------------------------------------------------------------
CELERY_BEAT_MAX_LOOP_INTERVAL=5
CELERY_BEAT_REFRESH_SECONDS=30

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dotmac_erp
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Monitoring — Loki (log aggregation) + GlitchTip/Sentry (error tracking)
# -----------------------------------------------------------------------------
# These existed but were empty, and there were no collection agents in this
# repo, despite the app exposing /metrics and initialising GlitchTip in
# app/monitoring.py all along.
#
# Verified against dotmac-observe 2026-07-28, the actual state is:
#   logs    — ALREADY shipping, from a promtail outside this repo. Present in
#             Loki as host="server-158" with no `app` label, so unattributable
#             (which is why it reads as "missing from Grafana"). See the
#             warning below before enabling this repo's promtail.
#   metrics — genuinely absent. No Prometheus target exists for this host.
#   errors  — GlitchTip is running centrally; whether a project exists for this
#             app is unverified. SENTRY_DSN unset means it self-disables silently.
#
# app/monitoring.py disables error reporting silently when SENTRY_DSN is unset
# — the DSN is a credential, so keep the real value in OpenBao and reference it
# here rather than committing it.
LOKI_URL=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
MONITORING_SERVER=
APP_ENV=production

# -----------------------------------------------------------------------------
# Observability agents (promtail + vmagent → central Dotmac Observability)
# -----------------------------------------------------------------------------
# Set COMPOSE_PROFILES=observability to start the agents added in
# docker-compose.yml. Without it they do not run, which is the right default for
# local development. Setting it in .env means the ordinary `docker compose up -d`
# includes them, so a redeploy cannot silently drop collection.
#
# Left COMMENTED deliberately. On a host that already ships logs — which
# erp.dotmac.io does — uncommenting this before removing the existing agent
# doubles every log line. Read the warning at the end of this section first,
# then uncomment.
# COMPOSE_PROFILES=observability

# Identifies this deployment in Loki/Grafana. DEPLOY_HOST is the host name or
# IP; DEPLOY_ENV separates production from staging in every query.
DEPLOY_HOST=<this-host-name-or-ip>
DEPLOY_ENV=production

# Central ingestion endpoints. Verified against dotmac-observe on 2026-07-28.
LOKI_PUSH_URL=http://75.119.128.247:3100/loki/api/v1/push

# This is Prometheus' own remote-write receiver — verified enabled on
# dotmac-observe (web.enable-remote-write-receiver=true), so no separate
# VictoriaMetrics is needed on this host.
VM_REMOTE_WRITE_URL=http://75.119.128.247:9090/api/v1/write

# WARNING — READ BEFORE ENABLING promtail ON THIS HOST
# ---------------------------------------------------
# This host is ALREADY shipping logs to Loki, from a promtail that lives
# outside this repo (it is not in docker-compose.yml). It appears in Loki
# under host="server-158" with no `app` label — and is described in the fleet
# records as project "acme", which is a mislabel of this ERP host. That is
# precisely why these logs look absent in Grafana: present, but unattributable.
#
# Starting the promtail in this compose file WITHOUT removing that existing
# agent will ship every line twice. Before setting COMPOSE_PROFILES:
#   1. find the existing agent:  docker ps | grep -i promtail
#   2. stop and remove it, and disable whatever starts it
#   3. then enable this profile, which ships with app/host/environment labels
#
# Alternatively drop `promtail` from the profile and run vmagent only, then
# fix the labels on the existing agent instead.

# -----------------------------------------------------------------------------
# dotmac_sub Integration (subscriber management — selfcare.dotmac.io)
# Bootstrap/fallback; per-org creds are managed from the admin UI.
# -----------------------------------------------------------------------------
DOTMAC_SUB_API_URL=https://selfcare.dotmac.io
DOTMAC_SUB_API_TOKEN=
DOTMAC_SUB_WEBHOOK_SECRET=
# Outbound HMAC secret for ERP material-status callbacks to Selfcare.
ERP_SUB_WEBHOOK_SECRET=
# Required when signed material callbacks are active.
# The outbound-webhook allowlist is a PLATFORM ceiling: no organization may
# hold a row for it, and an organization can only narrow it (the
# `webhook_tenant_*` settings). Empty means deny every target.
# BOOTSTRAP ONLY: this seeds the platform row at first boot (create-if-missing)
# and is never read again once the row exists. On an already-seeded database,
# change the ceiling with PUT /api/v1/settings/automation/webhook_allowed_hosts,
# not by editing this variable.
WEBHOOK_ALLOWED_HOSTS=selfcare.dotmac.io
# Upper bound on any outbound webhook timeout, whichever channel asks for it.
# 300 is today's `webhook_timeout_seconds` maximum, so this default changes no
# deployment's behaviour; lower it deliberately.
WEBHOOK_MAX_TIMEOUT_SECONDS=300
DOTMAC_SUB_REQUEST_TIMEOUT=60.0
DOTMAC_SUB_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Mailcow Employee Offboarding (optional)
# -----------------------------------------------------------------------------
MAILCOW_OFFBOARDING_ENABLED=false
MAILCOW_BASE_URL=https://mail.dotmac.ng/api/v1
MAILCOW_API_KEY=
MAILCOW_REQUEST_TIMEOUT=20
MAILCOW_INACTIVE_FORWARD_TO=inactives@dotmac.ng
MAILCOW_AUTORESPONDER_SUBJECT=Mailbox no longer monitored
# ERP renders {full_name} and {email} before writing the Sieve vacation script.
MAILCOW_AUTORESPONDER_TEMPLATE="Thank you for your email.\n\nPlease note that {full_name} ({email}) is no longer with Dotmac Technologies, and this mailbox is no longer being monitored.\n\nIf your enquiry is related to technical support or an existing service, please contact support@dotmac.ng.\n\nFor sales, new services, or commercial enquiries, please contact sales@dotmac.ng.\n\nYour message will not be forwarded automatically, so please resend your enquiry to the appropriate email address above.\n\nThank you for your understanding."
MAILCOW_SIEVE_HOST=mail.dotmac.ng
MAILCOW_SIEVE_PORT=4190
MAILCOW_SIEVE_MASTER_USER=
MAILCOW_SIEVE_MASTER_PASSWORD=
MAILCOW_SIEVE_SCRIPT_NAME=sogo
MAILCOW_SIEVE_USE_STARTTLS=true
MAILCOW_SOGO_DB_HOST=
MAILCOW_SOGO_DB_PORT=3306
MAILCOW_SOGO_DB_NAME=mailcow
MAILCOW_SOGO_DB_USER=
MAILCOW_SOGO_DB_PASSWORD=
# Private Mailcow cleanup receiver endpoint, including /cleanup.
MAILCOW_SOGO_CLEANUP_URL=
MAILCOW_SOGO_CLEANUP_TOKEN=

# -----------------------------------------------------------------------------
# Gunicorn (Production)
# -----------------------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8002
GUNICORN_WORKERS=
GUNICORN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Runtime database admission (scripts/verify_runtime_admission.py, deploy 3c)
# -----------------------------------------------------------------------------
# The deploy's read-only admission check asserts the RUNTIME database identity
# only for modules a deployment has DECLARED active. Every flag below defaults
# to false, so the check passes — and says loudly that it proved nothing — on a
# deployment that has activated no module. Setting one to true is the ratchet:
# it demands that DATABASE_URL connect directly as app_user (NOSUPERUSER,
# NOBYPASSRLS), that the module's schema and table grants be present, and that
# real same-tenant and cross-tenant RLS probes pass.
#
# ACCOUNTING_COMPOSITION_ENABLED and TAX_COMPOSITION_ENABLED are the modules'
# OWN composition gates (app/accounting_adoption.py and
# app/services/finance/tax/adoption/composition.py); the admission check reads
# those rather than introducing a second flag with the same intent.
ACCOUNTING_COMPOSITION_ENABLED=false
TAX_COMPOSITION_ENABLED=false
# These four modules have no composition gate of their own, so their storage
# is opted into the runtime-identity ratchet explicitly, by an operator.
FILES_RUNTIME_ADMISSION_ENABLED=false
IMPORTS_RUNTIME_ADMISSION_ENABLED=false
NUMBERING_RUNTIME_ADMISSION_ENABLED=false
PEOPLE_RUNTIME_ADMISSION_ENABLED=false
# Two DISTINCT tenant UUIDs the isolation probes run against. Unset is fine
# while nothing is active; once a module is active an unset value fails the
# probe closed, because isolation cannot be proved against a single tenant.
RUNTIME_ADMISSION_TENANT_ID=
RUNTIME_ADMISSION_OTHER_TENANT_ID=
